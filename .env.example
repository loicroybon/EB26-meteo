# Surcharge des clés fournisseurs pour le runner GitHub Actions.
#
# Copier en .env pour un usage local :   cp .env.example .env
# Le .env réel est ignoré par git ; les mêmes noms existent en variables de
# dépôt sur GitHub (Settings > Secrets and variables > Actions > Variables).
#
# Une valeur non vide remplace la liste écrite dans config.js.
# Plusieurs clés se séparent par une virgule ; la PREMIÈRE est celle employée,
# l'ordre est donc l'ordre de préférence.

# meteoblue MOS — offre gratuite, une requête par point
EB26_METEOBLUE_CLES=QTysmp2OSKP7ba3j,wA5K7fDv1VmIF6US

# Windy point-forecast — offre gratuite
EB26_WINDY_CLES=LMtKS6ka4dr1ta1qijmvXBFLUorC6aar

# Météo-France portail-api — clé gratuite à créer sur portail-api.meteofrance.fr
# Seule voie directe vers AROME 1,3 km, le seul modèle qui résolve Belledonne.
EB26_METEOFRANCE_CLES=

# Open-Meteo — l'offre gratuite ne demande aucune clé.
# Renseigner seulement si vous prenez une offre payante pour lever les quotas.
EB26_OPENMETEO_CLES=

# MET Norway — libre, aucune clé. Présent pour mémoire.
EB26_METNO_CLES=
